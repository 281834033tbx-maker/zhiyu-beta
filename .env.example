# Copy outside the repository and fill in your own credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Required for public HTTPS deployments. Replace with your actual origin.
# ZHIYU_PUBLIC_ORIGIN=https://zhiyu.example.com

NPC_TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Docker: set HOST=0.0.0.0 in the container environment file.
# Keep ZHIYU_DATA_ROOT / ZHIYU_BUILD_ROOT at their defaults unless needed.
